# Database
DATABASE_URL=sqlite:///./job_auto_apply.db

# OpenRouter AI Configuration
# Get a FREE key at https://openrouter.ai/settings/keys (see API_KEYS.md for full steps)
# Leave OPENROUTER_API_KEY empty to run with offline, truthful fallback answers (100% free).
# ONCE you add the key, restart the app so it is picked up.
OPENROUTER_API_KEY=
# Free models (rate-limited but $0): google/gemma-4-31b-it:free, openai/gpt-oss-20b:free,
# z-ai/glm-5.2:free, or the auto-router "openrouter/free"
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: identify your app for OpenRouter rankings (free)
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Job Application Automation Assistant

# Application Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Job Search Configuration
DAILY_APPLICATION_TARGET=50
MINIMUM_SALARY_PHP=25000
COUNTRY=Philippines
ALLOW_REMOTE=True
ALLOW_FRESH_GRADUATE=True

# Browser Automation (requires: playwright install chromium - free)
HEADLESS_BROWSER=True
BROWSER_TIMEOUT_SECONDS=30

# Job Sources
ENABLE_LINKEDIN=False
ENABLE_INDEED=True
ENABLE_JOBSTREET=True
ENABLE_KALIBRR=True
ENABLE_GLASSDOOR=False
ENABLE_JORA=False
ENABLE_FOUNDIT=False

# Excluded Job Categories (comma-separated)
EXCLUDED_CATEGORIES=BPO,Call Center,Customer Service,Sales,Marketing,Network Technician
